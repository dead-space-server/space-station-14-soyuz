<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="680 560"
               SetSize="720 620">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="6 4 6 6">

        <PanelContainer Name="HeaderPanel">
            <BoxContainer Orientation="Horizontal" Margin="14 10 14 10" SeparationOverride="14">
                <TextureRect TexturePath="/Textures/_DeadSpace/_Soyuz/Interface/credits.png"
                             Modulate="#ffd34d"
                             MinSize="44 44"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center" />
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Name="BalanceLabel" StyleClasses="LabelBig" />
                    <Label Name="PlaytimeLabel" StyleClasses="LabelSubText" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="NoticePanel" Visible="False">
            <Label Name="NoticeLabel" Margin="10 6 10 6" />
        </PanelContainer>

        <TabContainer Name="MainTabs" VerticalExpand="True">

            <BoxContainer Name="ShopTab" Orientation="Vertical" SeparationOverride="6" Margin="4 4 4 4">
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <LineEdit Name="SearchInput" PlaceHolder="{Loc 'credits-shop-search-hint'}" HorizontalExpand="True" />
                    <OptionButton Name="CategoryFilter" MinWidth="220" />
                    <OptionButton Name="SortSelect" MinWidth="190" />
                </BoxContainer>
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="ShopList" Orientation="Vertical" SeparationOverride="6" Margin="0 0 8 0" />
                </ScrollContainer>
            </BoxContainer>

            <BoxContainer Name="HistoryTab" Orientation="Vertical" SeparationOverride="6" Margin="4 4 4 4">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="HistoryList" Orientation="Vertical" SeparationOverride="4" Margin="0 0 8 0" />
                </ScrollContainer>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="10">
                    <Button Name="PrevButton" Text="&lt;" MinWidth="40" />
                    <Label Name="PageLabel" VerticalAlignment="Center" />
                    <Button Name="NextButton" Text="&gt;" MinWidth="40" />
                </BoxContainer>
            </BoxContainer>

            <ScrollContainer Name="ReferralTab" HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="4 4 8 4">

                    <PanelContainer Name="CodePanel">
                        <BoxContainer Orientation="Vertical" Margin="12 10 12 10" SeparationOverride="6">
                            <Label Text="{Loc 'credits-referral-section-code'}" StyleClasses="LabelSubText" />
                            <LineEdit Name="CodeInput" Editable="False" HorizontalExpand="True" />
                            <RichTextLabel Name="RefInfo" HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="ApplyPanel">
                        <BoxContainer Orientation="Vertical" Margin="12 10 12 10" SeparationOverride="6">
                            <Label Text="{Loc 'credits-referral-section-apply'}" StyleClasses="LabelSubText" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <LineEdit Name="RefInput" PlaceHolder="{Loc 'credits-referral-apply-hint'}" HorizontalExpand="True" />
                                <Button Name="ApplyButton" Text="{Loc 'credits-referral-apply-button'}" />
                            </BoxContainer>
                            <RichTextLabel Name="RefStatus" HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="StatsPanel">
                        <BoxContainer Orientation="Vertical" Margin="12 10 12 10" SeparationOverride="8">
                            <Label Text="{Loc 'credits-referral-section-stats'}" StyleClasses="LabelSubText" />
                            <GridContainer Columns="4" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="StatInvited" StyleClasses="LabelBig" HorizontalAlignment="Center" />
                                    <Label Text="{Loc 'credits-stat-invited'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="StatRewarded" StyleClasses="LabelBig" HorizontalAlignment="Center" />
                                    <Label Text="{Loc 'credits-stat-rewarded'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="StatPending" StyleClasses="LabelBig" HorizontalAlignment="Center" />
                                    <Label Text="{Loc 'credits-stat-pending'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="StatEarned" StyleClasses="LabelBig" HorizontalAlignment="Center" />
                                    <Label Text="{Loc 'credits-stat-earned'}" StyleClasses="LabelSubText" HorizontalAlignment="Center" />
                                </BoxContainer>
                            </GridContainer>
                        </BoxContainer>
                    </PanelContainer>

                </BoxContainer>
            </ScrollContainer>

            <ScrollContainer Name="PromoTab" HScrollEnabled="False" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="4 4 8 4">
                    <PanelContainer Name="PromoPanel">
                        <BoxContainer Orientation="Vertical" Margin="12 10 12 10" SeparationOverride="6">
                            <Label Text="{Loc 'credits-promo-section'}" StyleClasses="LabelSubText" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <LineEdit Name="PromoInput" PlaceHolder="{Loc 'credits-promo-hint'}" HorizontalExpand="True" />
                                <Button Name="PromoButton" Text="{Loc 'credits-promo-button'}" />
                            </BoxContainer>
                            <RichTextLabel Name="PromoInfo" HorizontalExpand="True" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>

        </TabContainer>
    </BoxContainer>
</DefaultWindow>
