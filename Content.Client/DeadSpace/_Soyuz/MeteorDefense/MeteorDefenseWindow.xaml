<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'meteor-defense-title'}" MinWidth="480" Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="8">
        <Label Name="StatusLabel" StyleClasses="DeadSpaceListHeader" />
        <Label Name="ChargeLabel" />
        <Label Name="ReadyLabel" />
        <Label Name="CostLabel" />
        <Label Name="RateLabel" />
        <Label Name="LimitLabel" />
        <Label Text="{Loc 'meteor-defense-capacity-input'}" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="CapacityInput" HorizontalExpand="True" />
            <Button Name="ApplyButton" Text="{Loc 'meteor-defense-apply'}" StyleClasses="DeadSpaceAction" />
        </BoxContainer>
        <Label Name="ErrorLabel" />
        <Button Name="ToggleButton" StyleClasses="DeadSpaceAction" />
    </BoxContainer>
</controls:FancyWindow>
