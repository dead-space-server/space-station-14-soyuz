<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="1040 720" MinSize="860 560"
                      Title="{Loc 'repair-orders-window-title'}">
    <PanelContainer Name="BackgroundPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Margin="12 8" SeparationOverride="12">
                    <TextureRect TexturePath="/Textures/_DeadSpace/_Soyuz/interface/RepairOrders/service.png"
                                 SetSize="48 48" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                        <Label Text="{Loc 'repair-orders-service-title'}" StyleClasses="LabelHeading" FontColorOverride="#ECAF4F" />
                        <Label Text="{Loc 'repair-orders-service-subtitle'}" FontColorOverride="#94A6AD" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                        <Label Name="HeaderBalanceLabel" FontColorOverride="#ECAF4F" />
                        <Label Name="HeaderLevelLabel" FontColorOverride="#94A6AD" />
                    </BoxContainer>
                    <Button Name="BriefingButton" Text="{Loc 'repair-orders-briefing-title'}" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <Label Name="ActivationLabel" Text="{Loc 'repair-orders-activation-in-progress'}" FontColorOverride="#ECAF4F" Visible="False" />
            <Label Name="CompletionLabel" Text="{Loc 'repair-orders-completion-in-progress'}" FontColorOverride="#ECAF4F" Visible="False" />
            <BoxContainer Name="NavigationContainer" SeparationOverride="6" />
            <TabContainer Name="OrderTabs" TabsVisible="False" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer SeparationOverride="12" VerticalExpand="True" HorizontalExpand="True">
                    <PanelContainer Name="OffersPanel" SetWidth="286">
                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                            <Label Name="OfferCountLabel" StyleClasses="LabelHeading" FontColorOverride="#ECAF4F" />
                            <BoxContainer>
                                <Label Text="{Loc 'repair-orders-next-offer'}" FontColorOverride="#94A6AD" HorizontalExpand="True" />
                                <Label Name="NextOfferLabel" Text="00:00" />
                            </BoxContainer>
                            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                <BoxContainer Name="AvailableContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
                            </ScrollContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="OfferDetailsPanel" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10">
                            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                                <BoxContainer Name="OfferDetailsContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10" />
                            </ScrollContainer>
                            <Label Name="OfferAvailabilityLabel" ClipText="True" FontColorOverride="#94A6AD" />
                            <Button Name="AcceptOrderButton" Text="{Loc 'repair-orders-accept'}" MinHeight="38" Disabled="True" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="12">
                        <BoxContainer Name="ActiveContainer" Orientation="Vertical" HorizontalExpand="True" />
                        <Label Text="{Loc 'repair-orders-completed-heading'}" StyleClasses="LabelHeading" FontColorOverride="#94A6AD" Margin="4 4 0 0" />
                        <BoxContainer Name="CompletedContainer" Orientation="Vertical" HorizontalExpand="True" />
                    </BoxContainer>
                </ScrollContainer>
                <PanelContainer Name="WorklistPanel" VerticalExpand="True" HorizontalExpand="True">
                    <ScrollContainer HScrollEnabled="False" Margin="10" VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Name="WorklistContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
                    </ScrollContainer>
                </PanelContainer>
                <BoxContainer Orientation="Vertical" SeparationOverride="10" HorizontalExpand="True" VerticalExpand="True">
                    <PanelContainer Name="ShopAccountPanel">
                        <BoxContainer Margin="12 8" SeparationOverride="24">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                <Label Name="ShopPointsLabel" FontColorOverride="#ECAF4F" StyleClasses="LabelHeading" />
                                <Label Name="ShopReputationLabel" FontColorOverride="#94A6AD" />
                            </BoxContainer>
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" MinWidth="240">
                                <Label Name="ShopLevelLabel" />
                                <Label Name="ShopProgressLabel" FontColorOverride="#94A6AD" />
                                <ProgressBar Name="ShopProgressBar" MinValue="0" MaxValue="1" MinHeight="8" HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer HorizontalExpand="True" VerticalExpand="True" SeparationOverride="12">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <BoxContainer SeparationOverride="8">
                                <LineEdit Name="ShopSearch" PlaceHolder="{Loc 'repair-orders-shop-search'}" HorizontalExpand="True" />
                                <CheckBox Name="ShopCompact" Text="{Loc 'repair-orders-shop-compact'}" />
                            </BoxContainer>
                            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                                <BoxContainer Name="ShopCatalogContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
                            </ScrollContainer>
                        </BoxContainer>
                        <PanelContainer Name="CartPanel" SetWidth="250">
                            <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                                <Label Text="{Loc 'repair-orders-shop-cart'}" StyleClasses="LabelHeading" FontColorOverride="#ECAF4F" />
                                <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                                    <BoxContainer Name="ShopCartContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                                </ScrollContainer>
                                <Label Name="ShopTotalLabel" FontColorOverride="#ECAF4F" />
                                <RichTextLabel Name="ShopResultLabel" HorizontalExpand="True" />
                                <Button Name="ShopCheckoutButton" Text="{Loc 'repair-orders-shop-checkout'}" MinHeight="38" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
