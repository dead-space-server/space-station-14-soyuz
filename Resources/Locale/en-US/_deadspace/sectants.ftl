# ─── Entities ───
ent-MobSectantAlphaMale = alp-male
    .desc = A horrifying creature from another world. An extremely tall figure, almost invisible to your eye, hovering in the air, barely touching the surface. Any weapon leaves no wounds on it, only exhausts this monster.

ent-MobSectantAlphaFemale = alp-female
    .desc = You feel the sinister presence of an otherworldly monster. A completely invisible creature radiating an aura of fear, causing terrible panic. You cannot see how dead it is, but you feel your knees trembling, aware that it is near.

ent-MobSectantHallucination = hallucination
    .desc = A wavering silhouette that inspires dread.

ent-MobSectantHallucinationIllusion = hallucination
    .desc = A wavering silhouette that inspires dread.

# ─── Actions ───
ent-ActionSectantSleep = Lull
    .desc = Puts nearby creatures to sleep.

ent-ActionSectantMaleExecute = Flesh Devour
    .desc = Deals 30 cellular damage to a downed enemy.

ent-ActionSectantMaleRandomBlink = Blink
    .desc = Teleports to a random nearby position.

ent-ActionSectantFemaleInvisibilityToggle = Conceal
    .desc = Toggles full invisibility.

ent-ActionSectantFemaleHack = Hack
    .desc = Hacks nearby airlocks and access points.

ent-ActionSectantFemaleHeal = Dark Blessing
    .desc = Heals nearby allies.

ent-ActionSectantFemaleBlink = Instant Step
    .desc = Teleports a short distance toward the cursor.

ent-ActionSectantFemaleHallucinate = Hallucination
    .desc = Creates low-HP hallucinations that debuff players.

# ─── Effects ───
ent-SectantExecuteEffect = execute effect
ent-SectantBlinkEffect = blink effect
ent-SectantHealEffect = heal effect
ent-SectantHallucinationSpawnEffect = hallucination spawn effect
ent-SectantDisappearEffect = disappear effect

# ─── Popups / Chat ───
sectant-disappear-message = The alp has vanished, but you feel it is not dead. Evil never dies.

sectant-male-execute-target-down = You drain the life out of { $target }
sectant-male-execute-target-not-down = The victim must be downed.

sectant-female-invisibility-on = You dissolve into shadow.
sectant-female-invisibility-off = You become visible.

# ─── Announcements ───
sectant-announce-arrival = IT IS APPROACHING…
sectant-announce-here = YOU CAN FEEL IT. IT IS ALREADY HERE.
