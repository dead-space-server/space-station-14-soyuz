uniform mediump vec4 auraColor;
uniform mediump float pulseSpeed;
uniform mediump float outlineWidth; // Базовая длина колючек в UV
uniform mediump float spikeCount;   // Количество колючек по кругу

void fragment() {
    mediump vec4 originalColor = texture(TEXTURE, UV);
    mediump float pulse = 0.6 + 0.4 * sin(TIME * pulseSpeed);

    // 1. Сам спрайт — подкрашиваем аурой
    if (originalColor.a > 0.1) {
        mediump vec3 tinted = mix(originalColor.rgb, auraColor.rgb, pulse * 0.7);
        COLOR = vec4(tinted, originalColor.a);
        return;
    }

    // 2. Прозрачный пиксель — проверяем, не рядом ли край спрайта
    mediump vec2 center = vec2(0.5, 0.5);
    mediump vec2 dir = UV - center;
    mediump float dist = length(dir);

    if (dist < 0.001) {
        COLOR = vec4(0.0);
        return;
    }

    mediump float angle = atan(dir.y, dir.x);

    // Колючесть: длина луча модулируется по углу + медленно вращается
    mediump float spike = abs(sin(angle * spikeCount + TIME * pulseSpeed * 0.5));
    mediump float radius = outlineWidth * pulse * (0.5 + spike);

    // Сэмплируем несколько точек по направлению к центру
    mediump vec2 dirN = normalize(dir);
    mediump float maxAlpha = 0.0;
    for (int i = 0; i < 4; i++) {
        mediump float t = float(i) / 3.0;
        mediump vec2 sampleUV = UV - dirN * radius * t;
        maxAlpha = max(maxAlpha, texture(TEXTURE, sampleUV).a);
    }

    if (maxAlpha > 0.1) {
        mediump float glow = 0.5 + 0.5 * pulse;
        COLOR = vec4(auraColor.rgb * glow, auraColor.a * maxAlpha * pulse);
    } else {
        COLOR = vec4(0.0);
    }
}
